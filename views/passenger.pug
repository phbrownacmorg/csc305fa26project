extends layout

block content
  h1= title

  if tickets
    if tickets.length > 0
      table
        caption
          h2 Tickets
        tr
          each col in Object.keys(tickets[0])
            th= col
        each row in tickets 
          tr
            each val in row
              td= val
            td
              form(action="", method="get")
                input(type="hidden",name="action",value="cancel_ticket")
                input(type="hidden",name="ID",value=`${formdata.ID}`)
                input(type="hidden",name="role",value=`${formdata.role}`)
                input(type="hidden",name="ticket_ID",value=`${row['Ticket']}`)
                input(type="submit",value="Cancel")
    else
      h2 No tickets to show

  //- This the date in GMT, so for the last few hours of each day this is ahead of Eastern Time.  Life's tough.
  - var today = (new Date()).toISOString().slice(0,10);

  if flights
    table
      caption
        h2 Flights 
      tr
        each col in Object.keys(flights[0])
          th= col
        th Book a flight
      each row in flights
        tr 
          each val in row
            td= val
          td
            form(action="", method="get")
              input(type="hidden",name="action",value="book_flight")
              input(type="hidden",name="ID",value=`${formdata.ID}`)
              input(type="hidden",name="role",value=`${formdata.role}`)
              input(type="hidden",name="FltNum",value=`${row['Flight']}`)
              input(type="date",name="FltDate",required,min=`${today}`)
              input(type="submit",value="Book")


  if formdata.role
    table
      caption
        h2 Form data
      tr
        th Key 
        th Value 
      each value, key in formdata
        tr 
          td= key 
          td= value
  else
    h2 No form data

